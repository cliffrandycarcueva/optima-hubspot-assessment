DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_me
DB_DATABASE=optima_hubspot_db
# NestJS API port. 3000 is reserved for the Next.js dashboard.
PORT=3001
NODE_ENV=development
# Use the same strong random value for the server and local sender.
WEBHOOK_SECRET=replace_with_a_random_secret
HUBSPOT_ACCESS_TOKEN=replace_me
# Copy IDs returned by npm run hubspot:check (not display names).
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_ID=appointmentscheduled
HUBSPOT_ORDER_ID_PROPERTY=optima_order_id
# Shared only by NestJS and the Next.js server.
DASHBOARD_API_KEY=replace_with_a_random_key_at_least_32_characters
# Set only after verifying /account-info/v3/details with the configured token.
HUBSPOT_PORTAL_ID=

# --- Automatic retries (all optional; defaults shown) ---
# In-request retries of one HubSpot HTTP call on 429/500/502/503/504/network errors.
# Max tries includes the first request. Delay = min(max, initial * multiplier^(n-1)), equal jitter.
HUBSPOT_RETRY_MAX_ATTEMPTS=5
HUBSPOT_RETRY_INITIAL_DELAY_MS=1000
HUBSPOT_RETRY_MULTIPLIER=2
HUBSPOT_RETRY_MAX_DELAY_MS=30000
# Durable order-level retries stored in PostgreSQL (orders.next_retry_at).
# Max attempts counts automatic attempts after a webhook/manual/command attempt; 0 disables scheduling.
SYNC_AUTO_RETRY_ENABLED=true
SYNC_AUTO_RETRY_MAX_ATTEMPTS=5
SYNC_AUTO_RETRY_INITIAL_DELAY_MS=60000
SYNC_AUTO_RETRY_MULTIPLIER=2
SYNC_AUTO_RETRY_MAX_DELAY_MS=3600000
SYNC_AUTO_RETRY_POLL_INTERVAL_MS=15000
# Pending/processing orders untouched this long are treated as interrupted and recovered.
SYNC_AUTO_RETRY_STALE_AFTER_MS=300000
